# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored by Next.js — never commit real credentials.

# The Gmail account that will SEND the enquiry emails (can be the same
# school Gmail, or a separate one you create just for the website).
GMAIL_USER=youraddress@gmail.com

# A Gmail "App Password" for that account — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# The inbox that should RECEIVE enquiries. Usually the same as GMAIL_USER,
# but can be a different address if you want them to land elsewhere.
TO_EMAIL=sangeetpathshalanepal@gmail.com
